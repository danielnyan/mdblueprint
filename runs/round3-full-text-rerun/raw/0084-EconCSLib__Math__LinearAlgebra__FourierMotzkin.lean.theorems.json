    "type": "theorem liftCoeff_inr (A : I \u2192 Fin (n+1) \u2192 \ud835\udd5c) (p : PosRows A) (q : NegRows A) (i : I) : liftCoeff A (Sum.inr (p, q)) i = (if p.val = i then -A q.val (Fin.last n) else 0) + (if q.val = i then A p.val (Fin.last n) else 0)"
