{
  "id": "social_choice.fair_division.indivisible.additive_instance",
  "title": "Indivisible Additive Instance",
  "kind": "definition",
  "status": "formalized",
  "href": "social_choice/social_choice_fair_division_indivisible_additive_instance.html",
