{
  "id": "game_theory.extensive_game.normal_form.semi_reduced_normal_form",
  "title": "Semi-Reduced Normal Form",
  "kind": "definition",
  "status": "formalized",
  "href": "game_theory/extensive_game/game_theory_extensive_game_normal_form_semi_reduced_normal_form.html",
