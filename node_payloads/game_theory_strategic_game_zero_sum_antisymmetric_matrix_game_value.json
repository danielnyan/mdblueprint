  "id": "game_theory.strategic_game.zero_sum.antisymmetric_matrix_game_value",
  "title": "Antisymmetric Matrix Game Has Value Zero",
  "kind": "theorem",
  "status": "proved",
  "href": "game_theory/zero_sum/game_theory_strategic_game_zero_sum_antisymmetric_matrix_game_value.html",
