{
  "id": "game_theory.extensive_game.core.strategy_profile_induced_outcome",
  "title": "Strategy Profile And Induced Outcome",
  "kind": "definition",
  "status": "formalized",
  "href": "game_theory/extensive_game/game_theory_extensive_game_core_strategy_profile_induced_outcome.html",
