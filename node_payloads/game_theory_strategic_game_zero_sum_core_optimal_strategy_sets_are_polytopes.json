{
  "id": "game_theory.strategic_game.zero_sum.core.optimal_strategy_sets_are_polytopes",
  "title": "Optimal Strategy Sets Are Polytopes",
  "kind": "proposition",
  "status": "proved",
  "href": "game_theory/zero_sum/game_theory_strategic_game_zero_sum_core_optimal_strategy_sets_are_polytopes.html",
  "primary_topic": "game_theory.zero_sum",
