{
  "id": "game_theory.strategic_game.zero_sum.core.optimal_pairs_are_saddle_points",
  "title": "Optimal Pairs Are Exactly Saddle Points",
  "kind": "theorem",
  "status": "proved",
  "href": "game_theory/zero_sum/game_theory_strategic_game_zero_sum_core_optimal_pairs_are_saddle_points.html",
  "primary_topic": "game_theory.zero_sum",
