{
  "id": "game_theory.strategic_game.zero_sum.core.mixed_strategy_simplex",
  "title": "Mixed Strategy Simplex",
  "kind": "definition",
  "status": "formalized",
  "href": "game_theory/zero_sum/game_theory_strategic_game_zero_sum_core_mixed_strategy_simplex.html",
