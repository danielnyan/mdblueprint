{
  "id": "game_theory.strategic_game.zero_sum.mixed_matrix_payoff",
  "title": "Expected Payoff of a Matrix Game",
  "kind": "definition",
  "status": "formalized",
  "href": "game_theory/zero_sum/game_theory_strategic_game_zero_sum_mixed_matrix_payoff.html",
