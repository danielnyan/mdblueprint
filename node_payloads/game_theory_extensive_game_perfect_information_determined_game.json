      "qualified_name": "GameTree.zermelo_determinacy",
      "module": "EconCSLib.GameTheory.ExtensiveGame.Zermelo",
      "kind": "theorem",
      "signature": "theorem zermelo_determinacy (g : GameTree (Fin 2) ℚ) (hzs : IsZeroSum g) :\n    (∀ σ' : Strategy (Fin 2) ℚ, IVariant (1 : Fin 2) optStrategy σ' →\n        value₀ g ≤ outcome σ' g 0) ∧\n    (∀ σ' : Strategy (Fin 2) ℚ, IVariant (0 : Fin 2) optStrategy σ' →\n        outcome σ' g 0 ≤ value₀ g)",
