      "module": "EconCSLib.GameTheory.StrategicGame.IESDS",
      "kind": "def",
      "signature": "def Survives (G : StrategicGame N U) : ℕ → (i : N) → G.strategy i → Prop\n  | 0 => fun _ _ => True\n  | n + 1 => fun i s =>\n      G.Survives n i s ∧\n      ¬ ∃ t : G.strategy i, G.Survives n i t ∧\n        ∀ σ : G.Profile, (∀ j, G.Survives n j (σ j)) →\n          G.payoff (deviate σ i s) i < G.payoff (deviate σ i t) i\n/-- Survival at round n+1 implies survival at round n. -/",
      "docstring": null,
