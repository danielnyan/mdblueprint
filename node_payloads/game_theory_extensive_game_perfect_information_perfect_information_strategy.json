{
  "id": "game_theory.extensive_game.perfect_information.perfect_information_strategy",
  "title": "Strategy In A Perfect-Information Game",
  "kind": "definition",
  "status": "formalized",
  "href": "game_theory/extensive_game/game_theory_extensive_game_perfect_information_perfect_information_strategy.html",
  "primary_topic": "game_theory.extensive_game",
